{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v jq >/dev/null 2>&1 || exit 0; jq -Rs '{hookSpecificOutput: {hookEventName: \"SessionStart\", additionalContext: .}}' \"${CLAUDE_PLUGIN_ROOT}/session.md\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
