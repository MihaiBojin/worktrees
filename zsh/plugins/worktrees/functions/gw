local navigation=0 arg
[[ $1 == (list|l) ]] && navigation=1
for arg in "$@"; do
    [[ $arg != -- ]] || break
    case $arg in --json|--list|-l|--help|-h|--complete|--explain) navigation=0 ;; esac
done
if [[ ! -t 0 ]] || (( ! navigation )); then
    command gw "$@"
    return $?
fi
# The sentinel preserves trailing LFs through command substitution.
local output code dest
output="$(command gw "$@"; code=$?; printf .; exit $code)"
code=$?
output=${output%.}
dest=${output%$'\n'}
if (( code == 0 )) && [[ $dest == /* && -d $dest ]]; then
    cd -- "$dest" || return $?
else
    printf '%s' "$output"
fi
return $code
