# gw [QUERY], or gw COMMAND: run COMMAND, or pick a worktree and cd into it.
#
# Every subcommand but list goes straight to the binary: capturing it would
# hold gwp's table back until after its prompt and strip its colour. The
# names come from the CLI, never from this file.
local -a subs
subs=(${${(f)"$(command gw --complete)"}%%$'\t'*})
if [[ $1 != list ]] && (( ${subs[(Ie)$1]} )); then
    command gw "$@"
    return
fi
# The rest is gwa's shim. `$(...)` strips only trailing newlines, so a path
# holding one arrives whole. Anything that is not a directory is what --json
# or --list asked for, so it is printed.
local dest
dest="$(command gw "$@")" || return
[[ -n $dest ]] || return 0
[[ -d $dest ]] || { print -r -- "$dest"; return 0; }
cd -- "$dest"
