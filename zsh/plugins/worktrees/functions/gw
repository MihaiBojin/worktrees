local -a commands=("${(@f)$(command gw --complete)}")
commands=("${commands[@]%%$'\t'*}")
local navigation=1 arg
if (( $# )) && (( ${commands[(Ie)$1]} )) && [[ $1 != list ]]; then
    navigation=0
fi
for arg in "$@"; do
    [[ $arg != -- ]] || break
    case $arg in --json|--list|-l|--help|-h|--complete|--explain) navigation=0 ;; esac
done
if [[ ! -t 0 ]] || (( ! navigation )); then
    command gw "$@"
    return $?
fi
# The sentinel preserves trailing LFs through command substitution.
local output code dest
output="$(command gw "$@"; code=$?; printf .; exit $code)"
code=$?
output=${output%.}
dest=${output%$'\n'}
if (( code == 0 )) && [[ $dest == /* && -d $dest ]]; then
    cd -- "$dest" || return $?
else
    printf '%s' "$output"
fi
return $code
