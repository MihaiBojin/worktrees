local lands=0 arg
case $1 in
    list|l) [[ -t 0 ]] && lands=1 ;;
    add|a|remove|rm) lands=1 ;;
esac
for arg in "$@"; do
    [[ $arg != -- ]] || break
    case $arg in --json|--table|--help|-h|--complete|--explain) lands=0 ;; esac
done
if (( ! lands )); then
    command gw "$@"
    return $?
fi
# The sentinel preserves trailing LFs through command substitution.
local output code dest
output="$(command gw "$@"; code=$?; printf .; exit $code)"
code=$?
output=${output%.}
dest=${output%$'\n'}
# A removal's destination stands even when later cleanup failed.
case $code:$1 in 0:*|*:remove|*:rm)
    if [[ $dest == /* && -d $dest ]]; then
        cd -- "$dest" || return $?
        return $code
    fi
esac
printf '%s' "$output"
return $code
