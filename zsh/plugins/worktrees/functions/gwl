# The sentinel preserves trailing LFs through command substitution.
local output code dest
output="$(command gwl "$@"; code=$?; printf .; exit $code)"
code=$?
output=${output%.}
dest=${output%$'\n'}
if (( code == 0 )) && [[ -n $dest && -d $dest ]]; then
    cd -- "$dest" || return $?
else
    printf '%s' "$output"
fi
return $code
