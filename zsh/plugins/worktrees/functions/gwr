# The sentinel preserves trailing LFs through command substitution.
local output code dest
output="$(command gwr "$@"; code=$?; printf .; exit $code)"
code=$?
output=${output%.}
dest=${output%$'\n'}
# A destination means removal succeeded, even if later cleanup failed.
if [[ -n $dest && -d $dest ]]; then
    cd -- "$dest" || return $?
else
    printf '%s' "$output"
fi
return $code
