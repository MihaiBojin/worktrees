#compdef gwp gwp! gwp!!

# Flags as `gwp --help` lists them.

_arguments -s \
    '(-v --verbose)'{-v,--verbose}'[print every git command]' \
    '*--delete[permit deletion categories]:value:(empty ignored-files stashes all)' \
    '--list[assess without prompting; uncoloured table]' \
    '*--only[filter assessment; rejects --yes]:verdict:(remove empty keep unknown)' \
    '(-y --yes)'{-y,--yes}'[approve removal, including with --json or --list]' \
    '--json[assess as JSON; --yes approves removal]' \
    '(-q --quiet)'{-q,--quiet}'[verdicts only]' \
    '--explain[print every git command and exit]' \
    '(-h --help)'{-h,--help}'[show the help and exit]'
