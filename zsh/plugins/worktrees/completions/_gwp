#compdef gwp gwp! gwp!!

# Flags as `gwp --help` lists them.

local -a verbose
if [[ ${words[1]} != (gw|worktrees) ]] && (( ! ${words[(Ie)--dry-run]} )); then
    verbose=('(-v --verbose)'{-v,--verbose}'[print every git command]')
fi

_arguments -s \
    $verbose \
    '*--delete[permit deletion categories]:value:(empty ignored-files stashes all)' \
    '--dry-run[report without deleting]' \
    '*--only[filter by verdict]:verdict:(remove empty keep unknown)' \
    '(-y --yes)'{-y,--yes}'[do not ask before removing]' \
    '--json[verdicts as data]' \
    '(-q --quiet)'{-q,--quiet}'[verdicts only]' \
    '--explain[print every git command and exit]' \
    '(-h --help)'{-h,--help}'[show the help and exit]'
