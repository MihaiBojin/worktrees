#compdef gwbd

local -a names descriptions
local line
for line in ${(f)"$(command gwbd --complete 2>/dev/null)"}; do
    names+=( ${line%%$'\t'*} )
    descriptions+=( "${line%%$'\t'*}:${line#*$'\t'}" )
done

_arguments -s \
    '--json[verdicts and evidence as data]' \
    '(-q --quiet -v --verbose)'{-q,--quiet}'[omit the summary]' \
    '(-q --quiet -v --verbose)'{-v,--verbose}'[print every git and forge command]' \
    '--explain[print every git command and exit]' \
    '(-h --help)'{-h,--help}'[show the help and exit]' \
    '--all[assess all local branches for deletion]' \
    '--dry-run[report without deleting]' \
    '*--delete[also delete a branch this covers]:value:(empty stashes all)' \
    '(-y --yes)'{-y,--yes}'[skip deletion confirmation]' \
    '*:branch:{_describe -t branches branch descriptions names}'
