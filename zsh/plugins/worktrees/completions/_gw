#compdef gw worktrees

_gw() {
    local -a subs descs
    local line curcontext="$curcontext" state

    if [[ ${words[2]} == -* ]]; then
        _gwp
        return
    fi
    _arguments -C \
        '(-h --help)'{-h,--help}'[show the help and exit]' \
        '1: :->command' \
        '*:: :->rest'

    case $state in
        command)
            for line in ${(f)"$(command gw --complete 2>/dev/null)"}; do
                subs+=( ${line%%$'\t'*} )
                descs+=( "${line%%$'\t'*}:${line#*$'\t'}" )
            done
            (( $#subs )) && _describe -t commands 'gw command' descs subs
            _gwl
            ;;
        rest)
            case ${words[1]} in
                sync)
                    _arguments -s \
                        '--json[sync state as data]' \
                        '(-q --quiet)'{-q,--quiet}'[omit the summary]' \
                        '(-v --verbose)'{-v,--verbose}'[print every command]' \
                        '(-h --help)'{-h,--help}'[show the help and exit]'
                    ;;
                prune|p) _gwp ;;
                add|a) _gwa ;;
                list|l|ls) _gwl ;;
                move|m|mv) _gwm ;;
                remove|rm) _gwr ;;
                rotate|rot) _gwrot ;;
                help|h) _gwh ;;
                branch)
                    _arguments -C '1:action:->branch' '*:: :->branch_args'
                    case $state in
                        branch)
                            local -a actions descriptions
                            for line in ${(f)"$(command gw branch --complete 2>/dev/null)"}; do
                                actions+=( ${line%%$'\t'*} )
                                descriptions+=( "${line%%$'\t'*}:${line#*$'\t'}" )
                            done
                            _describe -t commands 'branch command' descriptions actions
                            ;;
                        branch_args)
                            case ${words[1]} in
                                create) _gwbc ;;
                                status) _gwbs ;;
                                delete) _gwbd ;;
                            esac
                            ;;
                    esac
                    ;;
                -*) _gwp ;;
            esac
            ;;
    esac
}

_gw "$@"
