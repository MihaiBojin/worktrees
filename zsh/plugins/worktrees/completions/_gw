#compdef gw worktrees

__worktrees_names() {
    local -a names descs
    local line
    for line in ${(f)"$(command gw list --complete 2>/dev/null)"}; do
        names+=( ${line%%$'\t'*} )
        descs+=( "${line%%$'\t'*}:${line#*$'\t'}" )
    done
    (( $#names )) || return 1
    _describe -t worktrees worktree descs names
}

__worktrees_list() {
    _arguments -s \
        '(-l --list)'{-l,--list}'[print them all and pick none]' \
        '--json[the result as data]' \
        '--explain[print every git command and exit]' \
        '(-h --help)'{-h,--help}'[show the help and exit]' \
        '1:worktree:__worktrees_names'
}

_gw() {
    local -a subs descs
    local line curcontext="$curcontext" state

    if [[ ${words[2]} == -* ]]; then
        __worktrees_list
        return
    fi
    _arguments -C \
        '(-h --help)'{-h,--help}'[show the help and exit]' \
        '1: :->command' \
        '*:: :->rest'

    case $state in
        command)
            for line in ${(f)"$(command gw --complete 2>/dev/null)"}; do
                subs+=( ${line%%$'\t'*} )
                descs+=( "${line%%$'\t'*}:${line#*$'\t'}" )
            done
            (( $#subs )) && _describe -t commands 'gw command' descs subs
            __worktrees_list
            ;;
        rest)
            case ${words[1]} in
                sync)
                    _arguments -s \
                        '--json[sync state as data]' \
                        '(-q --quiet)'{-q,--quiet}'[omit the summary]' \
                        '(-v --verbose)'{-v,--verbose}'[print every command]' \
                        '(-h --help)'{-h,--help}'[show the help and exit]'
                    ;;
                version|v)
                    _arguments '(-h --help)'{-h,--help}'[show the help and exit]'
                    ;;
                prune|p) _gwp ;;
                add|a) _gwa ;;
                list) __worktrees_list ;;
                move|m|mv) _gwm ;;
                remove|rm) _gwr ;;
                rotate|rot) _gwrot ;;
                branch)
                    _arguments -C '1:action:->branch' '*:: :->branch_args'
                    case $state in
                        branch)
                            local -a actions descriptions
                            for line in ${(f)"$(command gw branch --complete 2>/dev/null)"}; do
                                actions+=( ${line%%$'\t'*} )
                                descriptions+=( "${line%%$'\t'*}:${line#*$'\t'}" )
                            done
                            _describe -t commands 'branch command' descriptions actions
                            ;;
                        branch_args)
                            case ${words[1]} in
                                create) _gwbc ;;
                                status) _gwbs ;;
                                delete) _gwbd ;;
                            esac
                            ;;
                    esac
                    ;;
                *) __worktrees_list ;;
            esac
            ;;
    esac
}

_gw "$@"
