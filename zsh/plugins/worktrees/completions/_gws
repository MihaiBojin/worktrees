#compdef gws

# Flags as `gws --help` lists them.

_arguments -s \
    '(-q --quiet -v --verbose)'{-q,--quiet}'[say nothing on success]' \
    '(-q --quiet -v --verbose)'{-v,--verbose}'[print every git and forge command]' \
    '--explain[print every git command and exit]' \
    '(-h --help)'{-h,--help}'[show the help and exit]'
